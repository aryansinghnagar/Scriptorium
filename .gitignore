# Scriptorium root .gitignore — repo holds templates/scripts/docs only.
# Runtime worlds live in ~/Worlds (outside this repo) and are never committed.

# Export and publishing outputs (in case a world folder is staged by accident)
*.pdf
*.epub
*.mobi
*.azw3
*.docx
04-Exports/
04-Publishing/

# Runtime world folders
Worlds/
00-World-Bible/
01-Manuscript/
02-Maps/
03-Art/

# Editor and IDE noise
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*~
.#*
\#*#

# Obsidian Vault runtime noise
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/graph.json
.obsidian/indexeddb/

# Operating System noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/

# Python and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Local backup directories and archives
05-Backups/
*.tar.xz
*.tar.gz
*.zip
*.7z

