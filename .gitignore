# Scriptorium root .gitignore — repo holds templates/scripts/docs only.
# Runtime worlds live in ~/Worlds (outside this repo) and are never committed.

# Export outputs (in case a world folder is ever staged by accident)
*.pdf
*.epub
*.mobi
*.azw3

# Editor / OS noise
.obsidian/workspace.json
.obsidian/cache
*.bak
*.tmp
*.log
.DS_Store
Thumbs.db
*~

# Local backup dirs and archives
05-Backups/
*.tar.xz
*.zip

# Verification artifacts (stay in /tmp, referenced by name in commit messages)
/tmp/
