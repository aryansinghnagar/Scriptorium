}

if [ $# -eq 0 ]; then
    if [ -t 0 ] && [ -t 1 ]; then
        interactive_menu
        exit 0
    fi
    usage
    exit 0
fi

COMMAND="$1"
shift

case "${COMMAND}" in
    # --- New Scaffolder Dispatcher ---
    new|create)
        if [ $# -eq 0 ]; then
            echo "Usage: arcanum new <manuscript|draft|world|universe|volume> <name> [options]" >&2
            exit 2
        fi
        SUBTYPE="$1"
        shift
        case "${SUBTYPE}" in
            manuscript|novel|book) cmd_manuscript "$@" ;;
            draft|new-draft|revision) cmd_draft "$@" ;;
            world|lore|vault) cmd_world "$@" ;;
            universe|cosmos|multiverse) cmd_universe "$@" ;;
            volume|add-volume|add-book|new-book) cmd_volume "$@" ;;
            *)
                echo "Error: Unknown project type '${SUBTYPE}' for 'arcanum new'." >&2
                exit 2
                ;;
        esac
        ;;

    # --- Write / Open Workspace ---
    write|open|launch)
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            RESOLVED="$(resolve_target_dir "${TARGET}")"
            if [ -n "${RESOLVED}" ] && [ -d "${RESOLVED}" ]; then
                NW_PROJ=""
                [ -f "${RESOLVED}/nwProject.nwx" ] && NW_PROJ="${RESOLVED}/nwProject.nwx"
                [ -f "${RESOLVED}/01-Manuscript/nwProject.nwx" ] && NW_PROJ="${RESOLVED}/01-Manuscript/nwProject.nwx"
                if [ -n "${NW_PROJ}" ]; then
                    if command -v flatpak &>/dev/null && flatpak info io.gitlab.novelwriter.novelWriter &>/dev/null; then
                        exec flatpak run io.gitlab.novelwriter.novelWriter "${NW_PROJ}"
                    elif command -v novelwriter &>/dev/null; then
                        exec novelwriter "${NW_PROJ}"
                    else
                        exec xdg-open "$(dirname "${NW_PROJ}")"
                    fi
                fi
                if [ -d "${RESOLVED}/Characters" ] || [ -f "${RESOLVED}/world.yaml" ] || [ -d "${RESOLVED}/.obsidian" ] || [ -d "${RESOLVED}/00-World-Bible" ]; then
                    OBS_TARGET="${RESOLVED}"
                    [ -d "${RESOLVED}/00-World-Bible" ] && OBS_TARGET="${RESOLVED}/00-World-Bible"
                    if command -v flatpak &>/dev/null && flatpak info md.obsidian.Obsidian &>/dev/null; then
                        exec flatpak run md.obsidian.Obsidian "${OBS_TARGET}"
                    elif command -v obsidian &>/dev/null; then
                        exec obsidian "${OBS_TARGET}"
                    else
                        exec xdg-open "${OBS_TARGET}"
                    fi
                fi
                exec xdg-open "${RESOLVED}"
            fi
        fi
        exec python3 "${PROJECT_ROOT}/scripts/arcanum_app.py" "$@"
        ;;

    # --- Core Universe, World Lore & Series Continuity ---
    universe|multiverse|init-universe)
        cmd_universe "$@"
        ;;
    world|init-world|init)
        cmd_world "$@"
        ;;
    map|cartography)
        exec python3 "${PROJECT_ROOT}/scripts/lib/cartography.py" "$@"
        ;;
    codex|wiki)
        exec python3 "${PROJECT_ROOT}/scripts/lib/codex_export.py" "$@"
        ;;
    series|series-continuity)
        exec python3 "${PROJECT_ROOT}/scripts/lib/series_continuity.py" "$@"
        ;;
    cast|dramatis-personae|dramatis|characters-cast)
        exec python3 "${PROJECT_ROOT}/scripts/lib/dramatis_personae.py" "$@"
        ;;
    concordance|glossary)
        exec python3 "${PROJECT_ROOT}/scripts/lib/concordance.py" "$@"
        ;;
    continuity|check-continuity)
        exec python3 "${PROJECT_ROOT}/scripts/lib/continuity.py" "$@"
        ;;
    faction|factions|geopolitics)
        exec python3 "${PROJECT_ROOT}/scripts/lib/factions.py" "$@"
        ;;
    economy|economies|ppp)
        exec python3 "${PROJECT_ROOT}/scripts/lib/economy.py" "$@"
        ;;
    causality|causal|timeline-dag)
        exec python3 "${PROJECT_ROOT}/scripts/lib/causality.py" "$@"
        ;;
    ecology|trophic|food-web)
        exec python3 "${PROJECT_ROOT}/scripts/lib/ecology.py" "$@"
        ;;
    climate|weather)
        exec python3 "${PROJECT_ROOT}/scripts/lib/climate.py" "$@"
        ;;
    idioms|idiom|eponyms|immersion)
        exec python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" idioms "$@"
        ;;
    senses|sensory|palette)
        exec python3 "${PROJECT_ROOT}/scripts/lib/senses.py" "$@"
        ;;
    prophecy|prophecies|oracle)
        exec python3 "${PROJECT_ROOT}/scripts/lib/prophecy.py" "$@"
        ;;
    world-doctor|lore-doctor)
        exec python3 "${PROJECT_ROOT}/scripts/lib/world_doctor.py" "$@"
        ;;
    magic-check)
        exec python3 "${PROJECT_ROOT}/scripts/lib/magic_system.py" check "$@"
        ;;
    magic-report)
        exec python3 "${PROJECT_ROOT}/scripts/lib/magic_system.py" report "$@"
        ;;
    magic|magic-system)
        exec python3 "${PROJECT_ROOT}/scripts/lib/magic_system.py" "$@"
        ;;
    genealogy|tree)
        exec python3 "${PROJECT_ROOT}/scripts/lib/genealogy.py" tree "$@"
        ;;
    lineage|dynasty|succession)
        exec python3 "${PROJECT_ROOT}/scripts/lib/genealogy.py" lineage "$@"
        ;;
    conlang|language-engine)
        exec python3 "${PROJECT_ROOT}/scripts/lib/conlang.py" "$@"
        ;;
    calendar|phases|syzygy)
        exec python3 "${PROJECT_ROOT}/scripts/lib/calendar.py" "$@"
        ;;

    # --- Calculations & Mechanics ---
    calc|calculator)
        if [ $# -eq 0 ]; then
            echo "Usage: arcanum calc <transit|time-dilation|orbit|comms|habitability|journey|battle|logistics|climate|system-dossier> [args...]" >&2
            exit 2
        fi
        CALC_SUB="$1"
        shift
        case "${CALC_SUB}" in
            journey|travel|overland)
                exec python3 "${PROJECT_ROOT}/scripts/lib/journey.py" "$@" ;;
            battle|lanchester|siege)
                exec python3 "${PROJECT_ROOT}/scripts/lib/factions.py" battle "$@" ;;
            logistics|supply|wagon)
                exec python3 "${PROJECT_ROOT}/scripts/lib/factions.py" logistics "$@" ;;
            climate|insolation|weather)
                exec python3 "${PROJECT_ROOT}/scripts/lib/climate.py" "$@" ;;
            trade|ppp|currency)
                exec python3 "${PROJECT_ROOT}/scripts/lib/economy.py" trade "$@" ;;
            transit|flight|brachistochrone)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" transit "$@" ;;
            time-dilation|dilation|lorentz)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" time-dilation "$@" ;;
            orbit|hohmann|transfer)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" orbit "$@" ;;
            comms|communication|latency)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" comms "$@" ;;
            habitability|gravity|hab)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" habitability "$@" ;;
            system-dossier|dossier)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" system-dossier "$@" ;;
            *)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" "${CALC_SUB}" "$@" ;;
        esac
        ;;
    sim|simulate)
        if [ $# -gt 0 ] && [ "$1" = "battle" ]; then
            shift
        fi
        exec python3 "${PROJECT_ROOT}/scripts/lib/tactical_sim.py" plan "$@"
        ;;
    ambient|soundscape|noise)
        exec python3 "${PROJECT_ROOT}/scripts/lib/ambient.py" generate "$@"
        ;;
    journey|expedition)
        exec python3 "${PROJECT_ROOT}/scripts/lib/journey.py" "$@"
        ;;

    # --- Manuscripts & Drafting ---
    manuscript|init-manuscript|novel)
        cmd_manuscript "$@"
        ;;
    docx|docx-sync|sync-docx)
        exec python3 "${PROJECT_ROOT}/scripts/lib/docx_sync.py" "$@"
        ;;
    word|writer|word-processor)
        exec python3 "${PROJECT_ROOT}/scripts/lib/docx_sync.py" open "$@"
        ;;
    draft|drafts|init-draft|new-draft|revision)
        cmd_draft "$@"
        ;;
    compare|diff|redline|changelog)
        exec python3 "${PROJECT_ROOT}/scripts/lib/manuscript_diff.py" "$@"
        ;;
    add-volume|add-book|new-book|volume)
        cmd_volume "$@"
        ;;
    export|publish|build|compile)
        cmd_export "$@"
        ;;
    preflight|pre-flight)
        exec python3 "${PROJECT_ROOT}/scripts/lib/preflight.py" "$@"
        ;;
    matter|frontmatter|backmatter)
        if [ $# -gt 0 ] && [ "$1" = "build" ]; then
            shift
        fi
        exec python3 "${PROJECT_ROOT}/scripts/lib/frontmatter_builder.py" build "$@"
        ;;
    query|synopsis|agent)
        exec python3 "${PROJECT_ROOT}/scripts/init_query.py" "$@"
        ;;
    polish|typography|clean-typography)
        if [ $# -gt 0 ] && [ "$1" = "typography" ]; then
            shift
        fi
        exec python3 "${PROJECT_ROOT}/scripts/lib/typography_cleaner.py" "$@"
        ;;
    plot|plot-matrix|subplot)
        exec python3 "${PROJECT_ROOT}/scripts/lib/plot_matrix.py" "$@"
        ;;
    structure|paradigm)
        exec python3 "${PROJECT_ROOT}/scripts/lib/structure.py" "$@"
        ;;
    portfolio|catalog)
        exec python3 "${PROJECT_ROOT}/scripts/lib/portfolio.py" "$@"
        ;;
    rag|query-lore|semantic-search|lore-query)
        exec python3 "${PROJECT_ROOT}/scripts/lib/local_rag.py" "$@"
        ;;
    branch|branching|narrative-threads|subway-map)
        exec python3 "${PROJECT_ROOT}/scripts/lib/branching_graph.py" "$@"
        ;;
    hub|dashboard|gui-web|studio-hub)
        exec python3 "${PROJECT_ROOT}/scripts/lib/studio_hub.py" "$@"
        ;;
    canvas|corkboard)
        exec python3 "${PROJECT_ROOT}/scripts/lib/story_canvas.py" "$@"
        ;;
    timeline|timeline-sync)
        exec python3 "${PROJECT_ROOT}/scripts/lib/timeline_sync.py" "$@"
        ;;
    omnibus)
        exec python3 "${PROJECT_ROOT}/scripts/lib/omnibus.py" "$@"
        ;;
    corpus|corpus-export|corpus-restore)
        exec python3 "${PROJECT_ROOT}/scripts/lib/corpus_export.py" "$@"
        ;;
    sprint|writing-sprint|pomodoro|session)
        exec python3 "${PROJECT_ROOT}/scripts/lib/writing_sprint.py" "$@"
        ;;
    revision-heatmap|churn|revision-density|draft-churn)
        exec python3 "${PROJECT_ROOT}/scripts/lib/revision_heatmap.py" "$@"
        ;;
    package|dist|bundle)
        exec python3 "${PROJECT_ROOT}/scripts/package_distribution.py" "$@"
        ;;
    migrate|upgrade)
        exec python3 "${PROJECT_ROOT}/scripts/lib/migrate.py" "$@"
        ;;
    report|wordcount|words|count|stats)
        exec python3 "${PROJECT_ROOT}/scripts/lib/diagnostics.py" words "$@"
        ;;
    pace|pacing)
        exec python3 "${PROJECT_ROOT}/scripts/lib/pacing.py" pace "$@"
        ;;
    tension|tension-arc)
        exec python3 "${PROJECT_ROOT}/scripts/lib/pacing.py" tension "$@"
        ;;
    voice|voice-profiler)
        exec python3 "${PROJECT_ROOT}/scripts/lib/voice.py" "$@"
        ;;
    cache|cache-engine)
        exec python3 "${PROJECT_ROOT}/scripts/lib/cache.py" "$@"
        ;;
    cache-clear)
        exec python3 "${PROJECT_ROOT}/scripts/lib/cache.py" clear "$@"
        ;;
    cache-scan)
        exec python3 "${PROJECT_ROOT}/scripts/lib/cache.py" scan "$@"
        ;;

    # --- Data Safety & Snapshots ---
    snapshot|snap|save|commit)
        cmd_snapshot "$@"
        ;;
    backup)
        cmd_backup "$@"
        ;;
    backup-dest|backup-destination)
        exec python3 "${PROJECT_ROOT}/scripts/lib/config.py" backup-dest "$@"
        ;;
    config|settings|preferences)
        exec python3 "${PROJECT_ROOT}/scripts/lib/config.py" "$@"
        ;;
    restore)
        cmd_restore "$@"
        ;;

    # --- System Diagnostics & Prose Audits ---
    audit)
        if [ $# -gt 0 ]; then
            AUDIT_SUB="$1"
            case "${AUDIT_SUB}" in
                dialogue|tags|said-bookisms)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" dialogue "$@"
                    ;;
                echoes|echo|repetition)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" echoes "$@"
                    ;;
                voice|voice-bleed)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/voice.py" "$@"
                    ;;
                scenes|scene|mru)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/scene_mechanics.py" "$@"
                    ;;
                structure|paradigm)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/structure.py" "$@"
                    ;;
                rhythm|readability)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" rhythm "$@"
                    ;;
                prose|stylistics)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" scan "$@"
                    ;;
                idioms|idiom|eponyms)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" idioms "$@"
                    ;;
                senses|sensory|palette)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/senses.py" "$@"
                    ;;
                tech|technology|anachronisms)
                    shift
                    exec python3 "${PROJECT_ROOT}/scripts/lib/economy.py" tech "$@"
                    ;;
            esac
        fi
        exec python3 "${PROJECT_ROOT}/scripts/lib/diagnostics.py" "$@"
        ;;
    doctor|check)
        exec python3 "${PROJECT_ROOT}/scripts/lib/diagnostics.py" "$@"
        ;;
    engines|plugins)
        exec python3 "${PROJECT_ROOT}/scripts/lib/cli.py" engines "$@"
        ;;
    menu|dashboard-cli|interactive)
        interactive_menu
        exit 0
        ;;
    control-center|dashboard|gui|app|ui)
        exec python3 "${PROJECT_ROOT}/scripts/arcanum_app.py" "$@"
        ;;
    verify|test|tests)
        exec bash "${PROJECT_ROOT}/scripts/verify.sh" "$@"
        ;;
    setup)
        exec bash "${PROJECT_ROOT}/scripts/setup_arcanum.sh" "$@"
        ;;

    # --- Global Flags ---
    -v|--version|version)
        echo "Ars Arcanum v${VERSION}"
        exit 0
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;

    # --- Unknown Command with Smart Suggestion ---
    *)
        python3 - "${COMMAND}" << 'SUGG_EOF'
import sys
import difflib

cmd = sys.argv[1]
known_commands = [
    "write", "open", "new", "create", "save", "snapshot", "publish", "export",
    "preflight", "matter", "query", "polish", "typography",
    "plot", "structure", "branch", "ambient", "portfolio", "package", "map", "codex",
    "series", "sim", "draft", "drafts", "compare", "diff", "redline", "changelog",
    "words", "count", "report", "universe", "world", "manuscript", "volume",
    "add-volume", "concordance", "continuity", "check-continuity", "doctor",
    "check", "world-doctor", "backup", "backup-dest", "config", "restore", "cache",
    "calc", "magic-check", "magic-report", "genealogy", "lineage", "conlang",
    "faction", "economy", "causality", "ecology", "climate", "idioms", "senses",
    "prophecy", "audit", "pace", "tension", "voice", "calendar", "journey",
    "gui", "control-center", "menu", "interactive", "verify", "setup", "version", "help",
    "cast", "dramatis-personae", "dramatis", "characters-cast", "corpus", "rag", "canvas", "timeline", "omnibus"
]

matches = difflib.get_close_matches(cmd, known_commands, n=1, cutoff=0.55)
if matches:
    print(f"Error: Unknown command '{cmd}'. Did you mean '{matches[0]}'?", file=sys.stderr)
else:
    print(f"Error: Unknown command '{cmd}'.", file=sys.stderr)
print("Run 'arcanum --help' for available commands and examples.", file=sys.stderr)
SUGG_EOF
        exit 2
        ;;
esac
