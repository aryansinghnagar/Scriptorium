#!/usr/bin/env bash
# ==============================================================================
# Ars Arcanum Unified CLI
# Purpose: Intuitive, human-friendly command-line interface for novel writing,
#          worldbuilding, typesetting, continuity diagnostics, and backups.
# ==============================================================================

set -euo pipefail

# PKG-01: dereference symlinks so packaged installs
# (/usr/bin/arcanum -> /usr/share/ars-arcanum/scripts/arcanum,
#  /app/bin/arcanum -> /app/share/ars-arcanum/scripts/arcanum)
# resolve to the real script directory instead of /usr/bin or /app/bin.
_RESOLVED_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${_RESOLVED_SCRIPT}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
if [ ! -f "${PROJECT_ROOT}/scripts/verify.sh" ]; then
    PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
fi
if [ ! -f "${PROJECT_ROOT}/scripts/verify.sh" ] && [ -f "${SCRIPT_DIR}/verify.sh" ]; then
    PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
    if [ ! -d "${PROJECT_ROOT}/scripts" ]; then
        PROJECT_ROOT="$SCRIPT_DIR"
    fi
fi

VERSION="3.7.0"

usage() {
    cat << USAGE
Ars Arcanum Unified CLI — v${VERSION}
An intuitive, fail-safe Linux writing and worldbuilding studio.

Usage:
  arcanum <command> [arguments...]
  ars-arcanum <command> [arguments...]

✍️  Core Authoring & Editorial Craft:
  hub [TARGET] [--port PORT]   Launch Sovereign Studio Desktop Hub & Telemetry Dashboard
  write [TARGET]               Open writing workspace in novelWriter or Obsidian (alias: open)
  word [MS]                    Open manuscript in Microsoft Word / LibreOffice (alias: writer)
  docx <build|sync|import|open> Manage Word .docx manuscript synchronization
  new <type> <NAME> [opts]     Scaffold new project (type: manuscript | draft | world | universe | volume)
  draft <MS> [DRAFT_NAME]      Fork next manuscript draft version (alias: new draft, init-draft)
  compare <MS> [D_NEW] [D_OLD] Visual Redline changelog comparison between drafts (alias: diff, redline)
  save [TARGET] [-m "note"]    Save an instant Git version milestone (alias: snapshot)
  publish [MS] [options]       Compile to print PDF, EPUB, or DOCX (alias: export)
  preflight [MS]               Pre-flight typesetting & compliance validator (PUB-101)
  barcode <ISBN>               Generate publication-grade ISBN-13 vector SVG/PNG barcode (PUB-102)
  matter build [MS]            Generate modular front matter and back matter files (PUB-103)
  query [MS]                   Scaffold submission package: query letter, synopsis, tracker (PUB-106)
  polish typography [TARGET]   Normalize smart curly quotes, em-dashes, and ellipses (PRO-104)
  read [TARGET] [--speak|--html] Offline neural audio proofreading & WebAudio player (INT-101)
  words [MS] [--md|--json|--pov] Show live word counts and chapter analytics (alias: report, count)
  pace [MS] [--pov|--html]     Analyze dialogue/action density & prose rhythm
  tension [MS] [--html]        Model chapter tension curve & narrative arcs
  plot [MS] [--html|--matrix]  Multi-track plot grid & subplot pacing matrix (PLT-101)
  structure [MS] [-p PARADIGM] Story paradigm enforcer: 3-Act, Save the Cat, Hero's Journey (PLT-102)
  freeze [TARGET] [options]    Cosmos archive freeze & cryptographic provenance seal
  ambient [PROFILE]            Focus noise & binaural beat synthesizer (PLT-106)
  portfolio [DIR] [--html]     Multi-manuscript catalog dashboard & drafting velocity (OPS-103)
  package [MS] [-t TARGET]     Multi-platform release packager: Reader, Submission, ARC (OPS-101)

🪐 Universe, World Lore & Series Continuity:
  universe [NAME] [--list]     Create or list narrative universes in ~/Universes/
  world <NAME> [-u UNIVERSE]   Scaffold an Obsidian World Lore Vault
  cast [UNIVERSE] [--html|--md] Multi-volume Dramatis Personae & Universe Cast Matrix (alias: dramatis-personae)
  map <WORLD> [--html|--svg]   Interactive offline vector cartography & map viewer (WOR-101)
  codex <WORLD> [--html]       Compile static offline World Wiki encyclopedia (WOR-102)
  series [TARGET] [--html]     Multi-book series continuity & character trait ledger (WOR-103)
  sim battle [options]         Turn-based tactical skirmish & battle simulator (WOR-104)
  concordance <TARGET> [-b]    Generate Dramatis Personae & Glossary back-matter
  continuity [-w W -m MS]      Analyze character traits & narrative consistency (alias: check-continuity)
  faction [WORLD] [--html]     Geopolitical relationship matrix & diplomatic paradoxes
  economy [WORLD] [-m MS]      Macroeconomic currencies, commodity baskets & PPP rates
  causality [WORLD] [MS]       Causal DAGs, time-travel loop & multiverse branching engine
  ecology [WORLD] [--html]     Trophic energy pyramids (10% rule) & bestiary food-web
  magic-check [-w W -m MS]     Verify hard magic system constraints & tier limits
  magic-report [-w W]          Export comprehensive arcane constraint report
  prophecy [WORLD] [-m MS]     Prophecy lifecycle clauses & fulfillment verification
  genealogy <House|Char>       Compile dynastic lineage trees & Mermaid flowcharts
  lineage <House>              Display succession rank roster & claimants
  conlang <gen|mut|lex> <Lang> Conlang phonotactics, sound-law shift & lexicon
  cipher <encode|decode|runes> In-world ciphers, Vigenere, Atbash & phonetic runes
  calendar [WORLD] [--phases]  Planetary calendar arithmetic & multi-moon syzygy
  calc <subcommand>            Astrophysics, climate, battle, logistics & journey calculator
  audit <subcommand>           Prose audits: dialogue, echoes, voice, scenes, structure, tech, idioms, senses

🔒 Data Protection & Safety:
  backup <TARGET> [options]    Create a verified, standalone .tar.gz backup archive
  backup-dest <get|set|clear>  Configure secure secondary backup destination (alias: config backup-dest)
  restore <ARCHIVE> [options]  Restore a project from a verified backup archive

🩺 System Health & Tools:
  doctor [options]             Run unified health & toolchain diagnostics (alias: check)
  world-doctor <WORLD> [opts]  Run deep World Bible lore consistency checks
  cache <scan|wordcounts|clear> Manage mtime-keyed fast performance cache
  gui [--tab TAB]              Launch desktop Control Center (aliases: app, control-center)
  menu                         Launch interactive numbered terminal dashboard (alias: interactive)
  verify                       Run canonical 7-stage test harness
  setup [--dry-run]            Install core packages, typography fonts, and launchers
  uninstall [--dry-run]        Revert desktop launchers and system components

Global Options:
  -v, --version                Display Ars Arcanum version
  -h, --help                   Display this help menu
USAGE
}

interactive_menu() {
    while true; do
        cat << 'MENU'
================================================================================
🪐 ✍️  ARS ARCANUM — Unified Authorial Ecosystem Dashboard
================================================================================
  [1] 🪐 Studio 1: Cosmos & Worlds (Universes, World Lore, Map, Codex, Series)
  [2] ✍️ Studio 2: Manuscripts & Drafting (Write, Word/DOCX, Drafts, Plot Grid)
  [3] 🔮 Studio 3: Speculative Fiction & Mechanics (Astrophysics, Magic, Battle Sim...)
  [4] 📚 Studio 4: Publishing & Typesetting (Preflight, Barcode, Matter, Exports)
  [5] 🔒 Studio 5: Vault Safety & Version History (Git Snapshots, Backup Archives)
  [6] 🩺 Studio 6: Diagnostics & Prose Audits (Dialogue, Voice, Echoes, Health)
  ------------------------------------------------------------------------------
  [g] 🖥️  Launch Desktop GUI Control Center
  [h] 📖 Display Full CLI Help Manual
  [q] 🚪 Exit Dashboard
================================================================================
MENU
        read -r -p "Enter selection [1-6, g, h, q]: " CHOICE || break
        case "${CHOICE}" in
            1)
                echo ""
                echo "--- Studio 1: Cosmos & Worlds ---"
                echo "  1) List Universes"
                echo "  2) Create New Universe"
                echo "  3) Create New World"
                echo "  4) Generate Vector Map"
                echo "  5) Export Static Codex Wiki"
                echo "  6) Check Series Continuity"
                echo "  b) Back"
                read -r -p "Choose action: " S1_CHOICE || break
                case "${S1_CHOICE}" in
                    1) bash "${PROJECT_ROOT}/scripts/init_universe.sh" --list ;;
                    2) read -r -p "Universe name: " UNAME && [ -n "$UNAME" ] && bash "${PROJECT_ROOT}/scripts/init_universe.sh" "$UNAME" ;;
                    3) read -r -p "World name: " WNAME && [ -n "$WNAME" ] && bash "${PROJECT_ROOT}/scripts/init_world.sh" "$WNAME" ;;
                    4) read -r -p "World path: " WDIR && [ -n "$WDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/cartography.py" "$WDIR" ;;
                    5) read -r -p "World path: " WDIR && [ -n "$WDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/codex_export.py" "$WDIR" ;;
                    6) read -r -p "Series path: " SDIR && [ -n "$SDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/series_continuity.py" "$SDIR" ;;
                    *) ;;
                esac
                ;;
            2)
                echo ""
                echo "--- Studio 2: Manuscripts & Drafting ---"
                echo "  1) Create New Manuscript"
                echo "  2) Fork Next Draft Version"
                echo "  3) Compare Drafts (Visual Redline Diff)"
                echo "  4) Multi-Track Plot Grid"
                echo "  5) Story Paradigm Enforcer"
                echo "  6) Audio Proofreader (TTS)"
                echo "  7) Portfolio Hub"
                echo "  b) Back"
                read -r -p "Choose action: " S2_CHOICE || break
                case "${S2_CHOICE}" in
                    1) read -r -p "Manuscript name: " MNAME && [ -n "$MNAME" ] && bash "${PROJECT_ROOT}/scripts/init_manuscript.sh" "$MNAME" ;;
                    2) read -r -p "Manuscript name: " MNAME && [ -n "$MNAME" ] && bash "${PROJECT_ROOT}/scripts/init_draft.sh" "$MNAME" ;;
                    3) read -r -p "Manuscript name: " MNAME && [ -n "$MNAME" ] && bash "${PROJECT_ROOT}/scripts/compare_drafts.sh" "$MNAME" ;;
                    4) read -r -p "Manuscript path: " MDIR && [ -n "$MDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/plot_matrix.py" "$MDIR" ;;
                    5) read -r -p "Manuscript path: " MDIR && [ -n "$MDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/structure.py" "$MDIR" ;;
                    6) read -r -p "Chapter path: " CPATH && [ -n "$CPATH" ] && python3 "${PROJECT_ROOT}/scripts/lib/tts_reader.py" "$CPATH" ;;
                    7) python3 "${PROJECT_ROOT}/scripts/lib/portfolio.py" ;;
                    *) ;;
                esac
                ;;
            3)
                echo ""
                echo "--- Studio 3: Speculative Fiction & Mechanics ---"
                echo "  1) Astrophysics & Orbital Flight"
                echo "  2) Hard Magic System Verification"
                echo "  3) Tactical Combat Simulator"
                echo "  4) Geopolitical Faction Matrix"
                echo "  5) Causal DAGs & Timeline Branching"
                echo "  6) Focus Ambient Generator"
                echo "  b) Back"
                read -r -p "Choose action: " S3_CHOICE || break
                case "${S3_CHOICE}" in
                    1) python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" transit --help ;;
                    2) read -r -p "World path: " WDIR && [ -n "$WDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/magic_system.py" check "$WDIR" ;;
                    3) python3 "${PROJECT_ROOT}/scripts/lib/tactical_sim.py" sim ;;
                    4) read -r -p "World path: " WDIR && [ -n "$WDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/factions.py" "$WDIR" ;;
                    5) read -r -p "World path: " WDIR && [ -n "$WDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/causality.py" "$WDIR" ;;
                    6) python3 "${PROJECT_ROOT}/scripts/lib/ambient.py" generate --help ;;
                    *) ;;
                esac
                ;;
            4)
                echo ""
                echo "--- Studio 4: Publishing & Typesetting ---"
                echo "  1) Pre-Flight Typesetting Linter"
                echo "  2) Generate ISBN-13 Barcode"
                echo "  3) Build Modular Front & Back Matter"
                echo "  4) Scaffold Query Submission Package"
                echo "  5) Polish Typography (Quotes & Dashes)"
                echo "  6) Export Complete Book (PDF/EPUB/DOCX)"
                echo "  7) Package Distribution Release"
                echo "  b) Back"
                read -r -p "Choose action: " S4_CHOICE || break
                case "${S4_CHOICE}" in
                    1) read -r -p "Manuscript path: " MDIR && [ -n "$MDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/preflight.py" "$MDIR" ;;
                    2) read -r -p "ISBN number: " ISBN && [ -n "$ISBN" ] && python3 "${PROJECT_ROOT}/scripts/lib/barcode.py" "$ISBN" ;;
                    3) read -r -p "Manuscript path: " MDIR && [ -n "$MDIR" ] && python3 "${PROJECT_ROOT}/scripts/lib/frontmatter_builder.py" build "$MDIR" ;;
                    4) read -r -p "Manuscript path: " MDIR && [ -n "$MDIR" ] && python3 "${PROJECT_ROOT}/scripts/init_query.py" "$MDIR" ;;
                    5) read -r -p "Target path: " TARG && [ -n "$TARG" ] && python3 "${PROJECT_ROOT}/scripts/lib/typography_cleaner.py" "$TARG" -i ;;
                    6) read -r -p "Manuscript to export: " MNAME && [ -n "$MNAME" ] && bash "${PROJECT_ROOT}/scripts/export_book.sh" "$MNAME" ;;
                    7) read -r -p "Manuscript path: " MDIR && [ -n "$MDIR" ] && python3 "${PROJECT_ROOT}/scripts/package_distribution.py" "$MDIR" ;;
                    *) ;;
                esac
                ;;
            5)
                echo ""
                echo "--- Studio 5: Vault Safety & Version History ---"
                echo "  1) Save Point-in-Time Git Snapshot"
                echo "  2) Create Standalone .tar.gz Backup Archive"
                echo "  3) Restore from Backup Archive"
                echo "  4) Secondary Backup Destination Config"
                echo "  b) Back"
                read -r -p "Choose action: " S5_CHOICE || break
                case "${S5_CHOICE}" in
                    1) read -r -p "Target name or path: " TARG && [ -n "$TARG" ] && bash "${PROJECT_ROOT}/scripts/save_snapshot.sh" "$TARG" ;;
                    2) read -r -p "Target name or path: " TARG && [ -n "$TARG" ] && bash "${PROJECT_ROOT}/scripts/backup_world.sh" "$TARG" ;;
                    3) read -r -p "Archive path: " ARCH && [ -n "$ARCH" ] && bash "${PROJECT_ROOT}/scripts/restore_world.sh" "$ARCH" ;;
                    4) python3 "${PROJECT_ROOT}/scripts/lib/config.py" backup-dest get ;;
                    *) ;;
                esac
                ;;
            6)
                echo ""
                echo "--- Studio 6: Diagnostics & Prose Audits ---"
                echo "  1) System Health & Toolchain Doctor"
                echo "  2) Dialogue Mechanics & Said-Bookisms"
                echo "  3) Character Voice Profiler"
                echo "  4) Word Echoes Repetition Scanner"
                echo "  5) Scene Mechanics MRU Analyzer"
                echo "  6) Run Full 7-Stage Test Verification"
                echo "  b) Back"
                read -r -p "Choose action: " S6_CHOICE || break
                case "${S6_CHOICE}" in
                    1) bash "${PROJECT_ROOT}/scripts/arcanum_doctor.sh" ;;
                    2) read -r -p "Target path: " TARG && [ -n "$TARG" ] && python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" dialogue "$TARG" ;;
                    3) read -r -p "Target path: " TARG && [ -n "$TARG" ] && python3 "${PROJECT_ROOT}/scripts/lib/voice.py" "$TARG" ;;
                    4) read -r -p "Target path: " TARG && [ -n "$TARG" ] && python3 "${PROJECT_ROOT}/scripts/lib/stylistics.py" echoes "$TARG" ;;
                    5) read -r -p "Target path: " TARG && [ -n "$TARG" ] && python3 "${PROJECT_ROOT}/scripts/lib/scene_mechanics.py" "$TARG" ;;
                    6) bash "${PROJECT_ROOT}/scripts/verify.sh" ;;
                    *) ;;
                esac
                ;;
            g|G|gui)
                if [ -f "${PROJECT_ROOT}/scripts/arcanum_app.py" ]; then
                    python3 "${PROJECT_ROOT}/scripts/arcanum_app.py"
                else
                    bash "${PROJECT_ROOT}/scripts/control_center.sh"
                fi
                ;;
            h|H|help)
                usage
                ;;
            q|Q|exit|quit)
                echo "Exiting Ars Arcanum."
                exit 0
                ;;
            *)
                echo "Invalid option. Please choose from the menu."
                ;;
        esac
        echo ""
    done
}

if [ $# -eq 0 ]; then
    if [ -t 0 ] && [ -t 1 ]; then
        interactive_menu
        exit 0
    fi
    usage
    exit 0
fi

COMMAND="$1"
shift

case "${COMMAND}" in
    # --- New Scaffolder Dispatcher ---
    new|create)
        if [ $# -eq 0 ]; then
            echo "Usage: arcanum new <manuscript|draft|world|universe|volume> <name> [options]" >&2
            echo "" >&2
            echo "Available project types:" >&2
            echo "  manuscript <name> [-u UNIVERSE] [-w WORLD]  Create a novel manuscript" >&2
            echo "  draft <manuscript> [draft_name]             Fork next manuscript draft version" >&2
            echo "  world <name> [-u UNIVERSE]                  Create a World Lore Vault" >&2
            echo "  universe <name>                             Create a narrative Universe" >&2
            echo "  volume <manuscript> [volume]                Add Book-02/Book-03 to manuscript" >&2
            exit 2
        fi
        SUBTYPE="$1"
        shift
        case "${SUBTYPE}" in
            manuscript|novel|book)
                exec bash "${PROJECT_ROOT}/scripts/init_manuscript.sh" "$@"
                ;;
            draft|new-draft|revision)
                exec bash "${PROJECT_ROOT}/scripts/init_draft.sh" "$@"
                ;;
            world|lore|vault)
                exec bash "${PROJECT_ROOT}/scripts/init_world.sh" "$@"
                ;;
            universe|cosmos|multiverse)
                exec bash "${PROJECT_ROOT}/scripts/init_universe.sh" "$@"
                ;;
            volume|add-volume|add-book|new-book)
                exec bash "${PROJECT_ROOT}/scripts/add_book.sh" "$@"
                ;;
            *)
                echo "Error: Unknown project type '${SUBTYPE}' for 'arcanum new'." >&2
                echo "Valid types: manuscript, draft, world, universe, volume." >&2
                exit 2
                ;;
        esac
        ;;

    # --- Write / Open Workspace ---
    write|open|launch)
        TARGET="${1:-}"
        if [ -n "${TARGET}" ]; then
            # shellcheck source=scripts/lib/worlds.sh
            source "${PROJECT_ROOT}/scripts/lib/worlds.sh"
            RESOLVED="$(resolve_target_dir "${TARGET}")"
            if [ -n "${RESOLVED}" ] && [ -d "${RESOLVED}" ]; then
                # Check for novelWriter project
                NW_PROJ=""
                if [ -f "${RESOLVED}/nwProject.nwx" ]; then
                    NW_PROJ="${RESOLVED}/nwProject.nwx"
                elif [ -f "${RESOLVED}/01-Manuscript/nwProject.nwx" ]; then
                    NW_PROJ="${RESOLVED}/01-Manuscript/nwProject.nwx"
                fi

                if [ -n "${NW_PROJ}" ]; then
                    if command -v flatpak &>/dev/null && flatpak info io.gitlab.novelwriter.novelWriter &>/dev/null; then
                        exec flatpak run io.gitlab.novelwriter.novelWriter "${NW_PROJ}"
                    elif command -v novelwriter &>/dev/null; then
                        exec novelwriter "${NW_PROJ}"
                    else
                        exec xdg-open "$(dirname "${NW_PROJ}")"
                    fi
                fi

                # Check for World Lore Vault (Obsidian)
                if [ -d "${RESOLVED}/Characters" ] || [ -f "${RESOLVED}/world.yaml" ] || [ -d "${RESOLVED}/.obsidian" ] || [ -d "${RESOLVED}/00-World-Bible" ]; then
                    OBS_TARGET="${RESOLVED}"
                    [ -d "${RESOLVED}/00-World-Bible" ] && OBS_TARGET="${RESOLVED}/00-World-Bible"
                    if command -v flatpak &>/dev/null && flatpak info md.obsidian.Obsidian &>/dev/null; then
                        exec flatpak run md.obsidian.Obsidian "${OBS_TARGET}"
                    elif command -v obsidian &>/dev/null; then
                        exec obsidian "${OBS_TARGET}"
                    else
                        exec xdg-open "${OBS_TARGET}"
                    fi
                fi

                exec xdg-open "${RESOLVED}"
            fi
        fi
        # Default: Launch Control Center GUI
        if [ -f "${PROJECT_ROOT}/scripts/arcanum_app.py" ]; then
            exec python3 "${PROJECT_ROOT}/scripts/arcanum_app.py" "$@"
        else
            exec bash "${PROJECT_ROOT}/scripts/control_center.sh" "$@"
        fi
        ;;

    # --- Universe & World Lore ---
    universe|multiverse)
        exec bash "${PROJECT_ROOT}/scripts/init_universe.sh" "$@"
        ;;
    world|init-world|init)
        exec bash "${PROJECT_ROOT}/scripts/init_world.sh" "$@"
        ;;
    map|cartography)
        exec python3 "${PROJECT_ROOT}/scripts/lib/cartography.py" "$@"
        ;;
    codex|wiki)
        exec python3 "${PROJECT_ROOT}/scripts/lib/codex_export.py" "$@"
        ;;
    series|series-continuity)
        exec python3 "${PROJECT_ROOT}/scripts/lib/series_continuity.py" "$@"
        ;;
    cast|dramatis-personae|dramatis|characters-cast)
        exec python3 "${PROJECT_ROOT}/scripts/lib/dramatis_personae.py" "$@"
        ;;
    concordance|glossary)
        exec bash "${PROJECT_ROOT}/scripts/generate_concordance.sh" "$@"
        ;;
    continuity|check-continuity)
        exec python3 "${PROJECT_ROOT}/scripts/lib/continuity.py" "$@"
        ;;
    faction|factions|geopolitics)
        exec python3 "${PROJECT_ROOT}/scripts/lib/factions.py" "$@"
        ;;
    economy|economies|ppp)
        exec python3 "${PROJECT_ROOT}/scripts/lib/economy.py" "$@"
        ;;
    causality|causal|timeline-dag)
        exec python3 "${PROJECT_ROOT}/scripts/lib/causality.py" "$@"
        ;;
    ecology|trophic|food-web)
        exec python3 "${PROJECT_ROOT}/scripts/lib/ecology.py" "$@"
        ;;
    climate|weather)
        exec python3 "${PROJECT_ROOT}/scripts/lib/climate.py" "$@"
        ;;
    idioms|idiom|eponyms|immersion)
        exec python3 "${PROJECT_ROOT}/scripts/lib/idioms.py" "$@"
        ;;
    senses|sensory|palette)
        exec python3 "${PROJECT_ROOT}/scripts/lib/senses.py" "$@"
        ;;
    cipher|ciphers|runes|inscription)
        exec python3 "${PROJECT_ROOT}/scripts/lib/cipher.py" "$@"
        ;;
    prophecy|prophecies|oracle)
        exec python3 "${PROJECT_ROOT}/scripts/lib/prophecy.py" "$@"
        ;;
    world-doctor|lore-doctor)
        exec bash "${PROJECT_ROOT}/scripts/world_doctor.sh" "$@"
        ;;
    magic-check)
        exec python3 "${PROJECT_ROOT}/scripts/lib/magic_system.py" check "$@"
        ;;
    magic-report)
        exec python3 "${PROJECT_ROOT}/scripts/lib/magic_system.py" report "$@"
        ;;
    magic|magic-system)
        exec python3 "${PROJECT_ROOT}/scripts/lib/magic_system.py" "$@"
        ;;
    genealogy|tree)
        exec python3 "${PROJECT_ROOT}/scripts/lib/genealogy.py" tree "$@"
        ;;
    lineage|dynasty|succession)
        exec python3 "${PROJECT_ROOT}/scripts/lib/genealogy.py" lineage "$@"
        ;;
    conlang|language-engine)
        exec python3 "${PROJECT_ROOT}/scripts/lib/conlang.py" "$@"
        ;;
    calendar|phases|syzygy)
        exec python3 "${PROJECT_ROOT}/scripts/lib/calendar.py" "$@"
        ;;

    # --- Speculative Calculations & Simulation ---
    calc|calculator)
        if [ $# -eq 0 ]; then
            echo "Usage: arcanum calc <transit|time-dilation|orbit|comms|habitability|journey|battle|logistics|climate> [args...]" >&2
            exit 2
        fi
        CALC_SUB="$1"
        shift
        case "${CALC_SUB}" in
            journey|travel|overland)
                exec python3 "${PROJECT_ROOT}/scripts/lib/journey.py" "$@"
                ;;
            battle|lanchester|siege)
                exec python3 "${PROJECT_ROOT}/scripts/lib/factions.py" battle "$@"
                ;;
            logistics|supply|wagon)
                exec python3 "${PROJECT_ROOT}/scripts/lib/factions.py" logistics "$@"
                ;;
            climate|insolation|weather)
                exec python3 "${PROJECT_ROOT}/scripts/lib/climate.py" "$@"
                ;;
            trade|ppp|currency)
                exec python3 "${PROJECT_ROOT}/scripts/lib/economy.py" trade "$@"
                ;;
            transit|flight|brachistochrone)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" transit "$@"
                ;;
            time-dilation|dilation|lorentz)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" time-dilation "$@"
                ;;
            orbit|hohmann|transfer)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" orbit "$@"
                ;;
            comms|communication|latency)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" comms "$@"
                ;;
            habitability|gravity|hab)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" habitability "$@"
                ;;
            *)
                exec python3 "${PROJECT_ROOT}/scripts/lib/astrophysics.py" "${CALC_SUB}" "$@"
                ;;
        esac
        ;;
    sim|simulate)
        if [ $# -gt 0 ] && [ "$1" = "battle" ]; then
            shift
        fi
        exec python3 "${PROJECT_ROOT}/scripts/lib/tactical_sim.py" sim "$@"
        ;;
    ambient|soundscape|noise)
        exec python3 "${PROJECT_ROOT}/scripts/lib/ambient.py" generate "$@"
        ;;
    journey|expedition)
