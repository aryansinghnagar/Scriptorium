#!/usr/bin/env bash
# ==============================================================================
# Ars Arcanum Unified CLI
# Purpose: Intuitive, fail-safe, 100% offline command-line interface for novel
#          writing, worldbuilding, typesetting, continuity, and backups.
# ==============================================================================

set -euo pipefail

# PKG-01: Dereference symlinks to find real script and project directories
_RESOLVED_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${_RESOLVED_SCRIPT}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
if [ ! -f "${PROJECT_ROOT}/scripts/verify.sh" ]; then
    PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
fi
if [ ! -f "${PROJECT_ROOT}/scripts/verify.sh" ] && [ -f "${SCRIPT_DIR}/verify.sh" ]; then
    PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
    if [ ! -d "${PROJECT_ROOT}/scripts" ]; then
        PROJECT_ROOT="$SCRIPT_DIR"
    fi
fi

VERSION="4.1.0"

# Source shared worlds discovery library
# shellcheck source=scripts/lib/worlds.sh
source "${PROJECT_ROOT}/scripts/lib/worlds.sh"

usage() {
    cat << USAGE
Ars Arcanum Unified CLI — v${VERSION}
