# ==============================================================================
# Built-in Core Operations Subroutines
# ==============================================================================

cmd_universe() {
    local list_mode=0
    local uname=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -l|--list) list_mode=1; shift ;;
            -n|--name) uname="$2"; shift 2 ;;
            -h|--help)
                echo "Usage: arcanum universe [NAME] [--list]"
                return 0 ;;
            *) uname="$1"; shift ;;
        esac
    done

    mkdir -p "${UNIVERSES_BASE}"
    if [ "${list_mode}" -eq 1 ] || { [ -z "${uname}" ] && [ ! -t 0 ]; }; then
        echo "Discovered Universes in ${UNIVERSES_BASE}:"
        local count=0
        while IFS= read -r -d '' d; do
            local bn
            bn="$(basename "$d")"
            local worlds_count
            worlds_count=$(find "${d}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name '.git' 2>/dev/null | wc -l || echo 0)
            echo "  • ${bn} (${worlds_count} worlds) -> ${d}"
            count=$((count + 1))
        done < <(find "${UNIVERSES_BASE}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -print0 2>/dev/null)
        [ "${count}" -eq 0 ] && echo "  (No Universes found yet. Create one with: arcanum universe <name>)"
        return 0
    fi

    if [ -z "${uname}" ]; then
        if has_gui; then
            uname=$(zenity --entry --title="New Universe" --text="Enter Universe Name:" --entry-text="Default-Universe" || true)
        else
            read -rp "Enter Universe Name (default: Default-Universe): " uname
        fi
        [ -z "${uname}" ] && uname="Default-Universe"
    fi

    uname="$(printf '%s' "${uname}" | tr ' ' '-' | tr -cd 'A-Za-z0-9_-' | cut -c1-64)"
    if [ -z "${uname}" ] || [ "${uname}" = "." ] || [ "${uname}" = ".." ]; then
        echo "Error: Invalid universe name." >&2; return 1
    fi

    local target_dir="${UNIVERSES_BASE}/${uname}"
    if [ -d "${target_dir}" ]; then
        echo "Universe '${uname}' already exists at: ${target_dir}"
        return 0
    fi

    echo "Scaffolding Narrative Universe: ${uname} ..."
    mkdir -p "${target_dir}"

    cat << EOF > "${target_dir}/universe.yaml"
# Ars Arcanum Universe Manifest
schema_version: "1.0"
name: "${uname}"
created_at: "$(date +%Y-%m-%d)"
description: "Narrative Universe housing interconnected worlds and lore."
EOF

    cat << EOF > "${target_dir}/Universe-Index.md"
---
type: universe_index
universe: "${uname}"
created: "$(date +%Y-%m-%d)"
tags:
  - meta/universe
---

# 🌌 ${uname} — Narrative Universe Hub

**Universe**: \`${uname}\`  
**Created**: $(date +%Y-%m-%d)  

This central index coordinates all interconnected worlds, overarching continuity, shared celestial mechanics, and cross-world lore across the **${uname}** cosmos.
EOF

    cat << 'EOF' > "${target_dir}/.gitignore"
*.bak
*.tmp
*.log
.DS_Store
EOF

    if command -v git &>/dev/null; then
        (
            cd "${target_dir}"
            git init -q
            git add .
            git_commit_safe "Initial Ars Arcanum universe repository: ${uname}"
        ) || true
    fi

    echo "[✓] Universe '${uname}' created successfully at: ${target_dir}"
}

cmd_world() {
    local wname=""
    local uname=""
    local legacy_root=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -u|--universe) uname="$2"; shift 2 ;;
            -n|--name) wname="$2"; shift 2 ;;
            --legacy-worlds-dir) legacy_root=1; shift ;;
            -h|--help)
                echo "Usage: arcanum world <NAME> [-u UNIVERSE] [--legacy-worlds-dir]"
                return 0 ;;
            *) wname="$1"; shift ;;
        esac
    done

    if [ -z "${wname}" ]; then
        if has_gui; then
            wname=$(zenity --entry --title="New World Lore Vault" --text="Enter World Name:" --entry-text="New-World" || true)
        else
            read -rp "Enter World Name: " wname
        fi
    fi

    wname="$(printf '%s' "${wname}" | tr ' ' '-' | tr -cd 'A-Za-z0-9_-' | cut -c1-64)"
    if [ -z "${wname}" ] || [ "${wname}" = "." ] || [ "${wname}" = ".." ]; then
        echo "Error: Invalid world name." >&2; return 1
    fi

    local dest_parent=""
    if [ "${legacy_root}" -eq 1 ]; then
        dest_parent="${LEGACY_WORLDS_BASE}"
    elif [ -n "${uname}" ]; then
        dest_parent="${UNIVERSES_BASE}/${uname}"
    else
        dest_parent="${UNIVERSES_BASE}/Default-Universe"
    fi
    mkdir -p "${dest_parent}"

    local target_dir="${dest_parent}/${wname}"
    if [ -d "${target_dir}" ]; then
        echo "Error: World '${wname}' already exists at: ${target_dir}" >&2
        return 1
    fi

    echo "Scaffolding World Lore Bible: ${wname} ..."
    local tpl_dir="${PROJECT_ROOT}/templates/world-bible"
    if [ -d "${tpl_dir}" ]; then
        cp -r "${tpl_dir}" "${target_dir}"
    else
        mkdir -p "${target_dir}/Characters" "${target_dir}/Locations" "${target_dir}/Factions" "${target_dir}/Magic" "${target_dir}/Cosmology" "${target_dir}/Timeline" "${target_dir}/05-Backups"
    fi

    cat << EOF > "${target_dir}/world.yaml"
# Ars Arcanum World Bible Manifest
schema_version: "1.0"
world_name: "${wname}"
universe: "${uname:-Default-Universe}"
created_at: "$(date +%Y-%m-%d)"
EOF

    cat << 'EOF' > "${target_dir}/.gitignore"
.obsidian/workspace.json
.obsidian/cache
*.bak
*.tmp
*.log
.DS_Store
05-Backups/
Backups/
Exports/
EOF

    if command -v git &>/dev/null; then
        (
            cd "${target_dir}"
            git init -q
            git add .
            git_commit_safe "Initial Ars Arcanum World Lore Vault: ${wname}"
        ) || true
    fi

    echo "[✓] World Lore Bible '${wname}' created successfully at: ${target_dir}"
}

cmd_manuscript() {
    local mname=""
    local uname=""
    local wname=""
    local author="Author Name"
    while [ $# -gt 0 ]; do
        case "$1" in
            -u|--universe) uname="$2"; shift 2 ;;
            -w|--world) wname="$2"; shift 2 ;;
            -a|--author) author="$2"; shift 2 ;;
            -n|--name) mname="$2"; shift 2 ;;
            -h|--help)
                echo "Usage: arcanum manuscript <NAME> [-u UNIVERSE] [-w WORLD] [-a AUTHOR]"
                return 0 ;;
            *) mname="$1"; shift ;;
        esac
    done

    if [ -z "${mname}" ]; then
        if has_gui; then
            mname=$(zenity --entry --title="New Manuscript" --text="Enter Manuscript Name:" --entry-text="My-Novel" || true)
        else
            read -rp "Enter Manuscript Name: " mname
        fi
    fi

    mname="$(printf '%s' "${mname}" | tr ' ' '-' | tr -cd 'A-Za-z0-9_-' | cut -c1-64)"
    if [ -z "${mname}" ] || [ "${mname}" = "." ] || [ "${mname}" = ".." ]; then
        echo "Error: Invalid manuscript name." >&2; return 1
    fi

    local target_dir="${MANUSCRIPTS_BASE}/${mname}"
    mkdir -p "${MANUSCRIPTS_BASE}"

    if [ -d "${target_dir}" ]; then
        echo "Error: Manuscript '${mname}' already exists at: ${target_dir}" >&2
        return 1
    fi

    echo "Scaffolding Manuscript Project: ${mname} ..."
    local tpl_dir="${PROJECT_ROOT}/templates/manuscript"
    if [ -d "${tpl_dir}" ]; then
        cp -r "${tpl_dir}" "${target_dir}"
    else
        mkdir -p "${target_dir}/Book-01/01_Act_I" "${target_dir}/Book-01/02_Act_II" "${target_dir}/Book-01/03_Act_III" "${target_dir}/03-Art" "${target_dir}/04-Publishing" "${target_dir}/05-Backups"
    fi

    cat << EOF > "${target_dir}/manuscript.yaml"
# Ars Arcanum Manuscript Manifest
schema_version: "1.0"
title: "${mname}"
author: "${author}"
universe: "${uname:-Default-Universe}"
world: "${wname:-}"
created_at: "$(date +%Y-%m-%d)"
EOF

    cat << 'EOF' > "${target_dir}/.gitignore"
*.bak
*.tmp
*.log
.DS_Store
05-Backups/
Backups/
04-Publishing/
Exports/
EOF

    if command -v git &>/dev/null; then
        (
            cd "${target_dir}"
            git init -q
            git add .
            git_commit_safe "Initial Ars Arcanum Manuscript: ${mname}"
        ) || true
    fi

    echo "[✓] Manuscript '${mname}' created successfully at: ${target_dir}"
}

cmd_volume() {
    local ms_target=""
    local vol_name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -m|--manuscript) ms_target="$2"; shift 2 ;;
            -n|--name) vol_name="$2"; shift 2 ;;
            -h|--help)
                echo "Usage: arcanum add-volume <MANUSCRIPT> [VOLUME_NAME]"
                return 0 ;;
            *)
                if [ -z "${ms_target}" ]; then ms_target="$1"; else vol_name="$1"; fi
                shift ;;
        esac
    done

    local resolved_ms
    resolved_ms="$(resolve_manuscript_dir "${ms_target}")"
    if [ -z "${resolved_ms}" ] || [ ! -d "${resolved_ms}" ]; then
        resolved_ms="$(resolve_target_dir "${ms_target}")"
    fi
    if [ -z "${resolved_ms}" ] || [ ! -d "${resolved_ms}" ]; then
        echo "Error: Manuscript '${ms_target}' not found." >&2; return 1
    fi

    if [ -z "${vol_name}" ]; then
        local highest=1
        for b in "${resolved_ms}"/Book-*; do
            if [ -d "${b}" ]; then
                local num
                num="$(basename "$b" | grep -oE '[0-9]+$' || echo 0)"
                [ "${num}" -gt "${highest}" ] && highest="${num}"
            fi
        done
        local next_num=$((highest + 1))
        vol_name=$(printf "Book-%02d" "${next_num}")
    fi

    arcanum_validate_volume_name "${vol_name}" || return 2
    local target_vol="${resolved_ms}/${vol_name}"
    if [ -d "${target_vol}" ]; then
        echo "Error: Volume '${vol_name}' already exists in '${resolved_ms}'." >&2; return 1
    fi

    echo "Adding Volume '${vol_name}' to '${resolved_ms}'..."
    mkdir -p "${target_vol}/01_Act_I" "${target_vol}/02_Act_II" "${target_vol}/03_Act_III" "${target_vol}/04_Back_Matter"

    cat << EOF > "${target_vol}/01_Act_I/01_Chapter_01.md"
# Chapter 1

Begin writing ${vol_name} here...
EOF

    if command -v git &>/dev/null; then
        (
            cd "${target_vol}"
            git init -q
            git add .
            git_commit_safe "Initial volume repository: ${vol_name}"
        ) || true
    fi

    echo "[✓] Volume '${vol_name}' scaffolded at: ${target_vol}"
}

cmd_draft() {
    local ms_target="${1:-}"
    local draft_name="${2:-Draft-02}"
    local vol="Book-01"
    shift 2 2>/dev/null || true
    while [ $# -gt 0 ]; do
        case "$1" in
            -b|--book|--volume) vol="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local resolved_ms
    resolved_ms="$(resolve_manuscript_dir "${ms_target}")"
    if [ -z "${resolved_ms}" ] || [ ! -d "${resolved_ms}" ]; then
        resolved_ms="$(resolve_target_dir "${ms_target}")"
    fi
    if [ -z "${resolved_ms}" ] || [ ! -d "${resolved_ms}" ]; then
        echo "Error: Manuscript '${ms_target}' not found." >&2; return 1
    fi

    local book_dir="${resolved_ms}/${vol}"
    if [ ! -d "${book_dir}" ]; then
        book_dir="${resolved_ms}"
    fi

    local target_draft="${book_dir}/${draft_name}"
    if [ -d "${target_draft}" ]; then
        echo "Error: Draft '${draft_name}' already exists in '${book_dir}'." >&2; return 1
    fi

    echo "Forking draft '${draft_name}' in '${book_dir}'..."
    mkdir -p "${target_draft}"

    # Copy chapters from primary acts
    for act in "${book_dir}"/0[1-9]_Act_*; do
        if [ -d "${act}" ]; then
            local act_name
            act_name="$(basename "${act}")"
            cp -r "${act}" "${target_draft}/${act_name}"
        fi
    done

    echo "[✓] Draft '${draft_name}' created at: ${target_draft}"
}

cmd_snapshot() {
    local target_input=""
    local note=""
    local universe_filter=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -w|--world|-m|--manuscript) target_input="$2"; shift 2 ;;
            -u|--universe) universe_filter="$2"; shift 2 ;;
            -m|--note) note="$2"; shift 2 ;;
            -h|--help)
                echo "Usage: arcanum snapshot [TARGET] [-m NOTE]"
                return 0 ;;
            *)
                if [ -z "${target_input}" ]; then target_input="$1"; else note="$1"; fi
                shift ;;
        esac
    done

    if ! command -v git &>/dev/null; then
        echo "Error: git is required to create snapshots." >&2; return 2
    fi

    discover_worlds WORLDS
    discover_manuscripts MANUSCRIPTS

    local selected=""
    if [ -n "${target_input}" ]; then
        selected="$(resolve_target_dir "${target_input}" "${universe_filter}")"
    elif [ ${#WORLDS[@]} -eq 1 ] && [ ${#MANUSCRIPTS[@]} -eq 0 ]; then
        selected="${WORLDS[0]}"
    elif [ ${#WORLDS[@]} -eq 0 ] && [ ${#MANUSCRIPTS[@]} -eq 1 ]; then
        selected="${MANUSCRIPTS[0]}"
    else
        local all_t=("${MANUSCRIPTS[@]}" "${WORLDS[@]}")
        if [ ${#all_t[@]} -eq 1 ]; then
            selected="${all_t[0]}"
        elif [ ${#all_t[@]} -gt 1 ]; then
            selected="${all_t[0]}"
        fi
    fi

    if [ -z "${selected}" ] || [ ! -d "${selected}" ]; then
        echo "Error: Target '${target_input}' not found." >&2; return 2
    fi

    local target_name
    target_name="$(basename "${selected}")"
    cd "${selected}"

    if [ ! -d ".git" ]; then
        git init -q
        cat << 'EOF' > .gitignore
.obsidian/workspace.json
.obsidian/cache
*.bak
*.tmp
*.log
.DS_Store
Backups/
05-Backups/
Exports/
04-Publishing/
EOF
        git -c advice.addEmbeddedRepo=false add .
        git_commit_safe "Initial repository creation for ${target_name}" || true
    fi

    local ts
    ts="$(date '+%Y-%m-%d %H:%M')"
    [ -z "${note}" ] && note="Snapshot: ${ts}"

    git -c advice.addEmbeddedRepo=false add -A
    if git diff --cached --quiet; then
        echo "No uncommitted changes in '${target_name}' since last snapshot."
        return 0
    fi

    if git_commit_safe "${note}"; then
        echo "[✓] Snapshot saved successfully for '${target_name}'! (Note: ${note})"
    else
        echo "[!] Snapshot failed: git commit rejected the change." >&2; return 1
    fi
}

cmd_backup() {
    local target_input=""
    local dest_cli=""
    local no_local=0
    local encrypted=0
    local passphrase=""
    local universe_cli=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -w|--world|-m|--manuscript) target_input="$2"; shift 2 ;;
            -u|--universe) universe_cli="$2"; shift 2 ;;
            -d|--dest) dest_cli="$2"; shift 2 ;;
            --no-local) no_local=1; shift ;;
            --symmetric|--encrypted) encrypted=1; shift ;;
            --passphrase) passphrase="$2"; shift 2 ;;
            -h|--help)
                echo "Usage: arcanum backup [TARGET] [-d DEST] [--no-local] [--symmetric] [--passphrase PASS]"
                return 0 ;;
            *)
                if [ -z "${target_input}" ]; then target_input="$1"; fi
                shift ;;
        esac
    done

    local world_dir
    world_dir="$(resolve_target_dir "${target_input}" "${universe_cli}")"
    if [ -z "${world_dir}" ] || [ ! -d "${world_dir}" ]; then
        echo "Error: Directory not found: ${target_input}" >&2; return 2
    fi

    local world_name
    world_name="$(basename "${world_dir}")"
    local timestamp
    timestamp="$(date +%Y%m%d-%H%M%S)"
    local safe_name
    safe_name="$(sanitize_name "${world_name}" "project")"

    local local_backup_dir="${world_dir}/05-Backups"
    [ ! -d "${local_backup_dir}" ] && local_backup_dir="${world_dir}/Backups"
    mkdir -p "${local_backup_dir}"

    local primary_backup_dir="${local_backup_dir}"
    if [ -n "${dest_cli}" ] && [ "${no_local}" -eq 1 ]; then
        primary_backup_dir="${dest_cli}"
    fi
    mkdir -p "${primary_backup_dir}"

    local archive_base="${safe_name}-backup-${timestamp}"
    local archive_tar="${primary_backup_dir}/${archive_base}.tar.gz"
    local checksum_file="${primary_backup_dir}/${archive_base}.sha256"
    local meta_file="${primary_backup_dir}/${archive_base}.meta.json"

    echo "Creating verified backup archive for: ${world_name} ..."
    local parent_dir
    parent_dir="$(dirname "${world_dir}")"
    local dir_basename
    dir_basename="$(basename "${world_dir}")"

    tar -czf "${archive_tar}" \
        -C "${parent_dir}" \
        --sort=name \
        --owner=0 --group=0 --numeric-owner \
        --exclude="${dir_basename}/05-Backups" \
        --exclude="${dir_basename}/Backups" \
        --exclude="${dir_basename}/Exports" \
        --exclude="${dir_basename}/04-Publishing" \
        --exclude="${dir_basename}/.obsidian/workspace.json" \
        --exclude="${dir_basename}/.obsidian/cache" \
        --exclude="*.bak" \
        --exclude="*.tmp" \
        --exclude="*.log" \
        "${dir_basename}"

    if [ ! -s "${archive_tar}" ] || ! tar -tzf "${archive_tar}" >/dev/null 2>&1; then
        echo "Error: Backup archive creation failed or corrupt: ${archive_tar}" >&2
        rm -f "${archive_tar}"
        return 1
    fi

    local final_archive="${archive_tar}"
    local final_archive_name="${archive_base}.tar.gz"
    local enc_type="none"

    if [ "${encrypted}" -eq 1 ]; then
        local gpg_cmd="gpg"
        command -v gpg &>/dev/null || gpg_cmd="gpg2"
        local archive_gpg="${primary_backup_dir}/${archive_base}.tar.gz.gpg"
        local gpg_args=(--batch --yes)
        [ -n "${passphrase}" ] && gpg_args+=(--pinentry-mode loopback --passphrase "${passphrase}")
        "${gpg_cmd}" "${gpg_args[@]}" --symmetric --cipher-algo AES256 -o "${archive_gpg}" "${archive_tar}"
        rm -f "${archive_tar}"
        final_archive="${archive_gpg}"
        final_archive_name="${archive_base}.tar.gz.gpg"
        enc_type="symmetric"
    fi

    local actual_sha
    actual_sha="$(sha256sum "${final_archive}" | cut -d' ' -f1)"
    echo "${actual_sha}  ${final_archive_name}" > "${checksum_file}"

    local git_commit="none"
    if [ -d "${world_dir}/.git" ] && command -v git &>/dev/null; then
        git_commit="$(git -C "${world_dir}" rev-parse HEAD 2>/dev/null || echo "none")"
    fi
    local archive_bytes
    archive_bytes="$(wc -c < "${final_archive}" | tr -d ' ')"

    python3 -c '
import json, sys
meta = {
    "world": sys.argv[1],
    "timestamp": sys.argv[2],
    "archive": sys.argv[3],
    "sha256": sys.argv[4],
    "size_bytes": int(sys.argv[5]),
    "git_commit": sys.argv[6],
    "note": "auto-backup",
    "encrypted": sys.argv[7] == "1",
    "encryption_type": sys.argv[8],
}
with open(sys.argv[9], "w", encoding="utf-8") as f:
    json.dump(meta, f, indent=2)
    f.write("\n")
' "${world_name}" "${timestamp}" "${final_archive_name}" "${actual_sha}" "${archive_bytes}" "${git_commit}" "${encrypted}" "${enc_type}" "${meta_file}"

    echo "[✓] Primary backup archive created and verified:"
    echo "    Archive:  ${final_archive}"
    echo "    SHA-256:  ${actual_sha}"
    echo "    Metadata: ${meta_file}"
}

cmd_restore() {
    local archive_input=""
    local target_name=""
    local dest_cli=""
    local force=0
    local passphrase=""
    local skip_checksum=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--archive) archive_input="$2"; shift 2 ;;
            -t|--target) target_name="$2"; shift 2 ;;
            -d|--dest) dest_cli="$2"; shift 2 ;;
            -f|--force) force=1; shift ;;
            --skip-checksum) skip_checksum=1; shift ;;
            --passphrase) passphrase="$2"; shift 2 ;;
            -h|--help)
                echo "Usage: arcanum restore <ARCHIVE.tar.gz> [--target NAME] [--dest DEST] [--force] [--passphrase PASS]"
                return 0 ;;
            *)
                if [ -z "${archive_input}" ]; then archive_input="$1"; fi
                shift ;;
        esac
    done

    if [ -z "${archive_input}" ] || [ ! -f "${archive_input}" ]; then
        echo "Error: Archive file not found: '${archive_input}'." >&2; return 1
    fi

    local archive_path
    archive_path="$(realpath "${archive_input}" 2>/dev/null || echo "${archive_input}")"
    local archive_dir
    archive_dir="$(dirname "${archive_path}")"
    local archive_file
    archive_file="$(basename "${archive_path}")"

    # Checksum validation
    local sha_file=""
    local base_no_gpg="${archive_file%.gpg}"
    local base_no_tar="${base_no_gpg%.tar.gz}"
    if [ -f "${archive_dir}/${base_no_tar}.sha256" ]; then
        sha_file="${archive_dir}/${base_no_tar}.sha256"
    elif [ -f "${archive_dir}/${archive_file}.sha256" ]; then
        sha_file="${archive_dir}/${archive_file}.sha256"
    fi

    if [ "${skip_checksum}" -eq 0 ] && [ -n "${sha_file}" ]; then
        local expected_sha
        expected_sha="$(head -n 1 "${sha_file}" | cut -d' ' -f1)"
        local actual_sha
        actual_sha="$(sha256sum "${archive_path}" | cut -d' ' -f1)"
        if [ "${expected_sha}" != "${actual_sha}" ]; then
            echo "Error: SHA-256 checksum verification failed!" >&2; return 1
        fi
        echo "[✓] SHA-256 Checksum Verified."
    fi

    local staging_dir
    staging_dir="$(mktemp -d -t arcanum_restore_XXXXXX)"
    trap 'rm -rf "${staging_dir:-}"' RETURN EXIT

    local target_tar="${archive_path}"
    if [[ "${archive_file}" == *.gpg ]]; then
        local gpg_cmd="gpg"
        command -v gpg &>/dev/null || gpg_cmd="gpg2"
        local dec_tar="${staging_dir}/decrypted.tar.gz"
        local gpg_args=(--batch --yes)
        [ -n "${passphrase}" ] && gpg_args+=(--pinentry-mode loopback --passphrase "${passphrase}")
        if ! "${gpg_cmd}" "${gpg_args[@]}" --decrypt -o "${dec_tar}" "${archive_path}" 2>/dev/null; then
            echo "Error: GPG decryption failed." >&2; return 1
        fi
        target_tar="${dec_tar}"
    fi

    tar -xzf "${target_tar}" -C "${staging_dir}" --no-same-owner --no-same-permissions

    local extracted_dir
    extracted_dir="$(find "${staging_dir}" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
    if [ -z "${extracted_dir}" ] || [ ! -d "${extracted_dir}" ]; then
        echo "Error: Archive did not contain a root project directory." >&2; return 1
    fi

    local orig_name
    orig_name="$(basename "${extracted_dir}")"
    local final_name="${target_name:-${orig_name}}"
    final_name="$(printf '%s' "${final_name}" | tr ' ' '-' | tr -cd 'A-Za-z0-9_-' | cut -c1-64)"
    if [ -z "${final_name}" ] || [ "${final_name}" = "." ] || [ "${final_name}" = ".." ]; then
        echo "Error: Invalid restore target name." >&2; return 1
    fi

    local dest_parent="${dest_cli}"
    if [ -z "${dest_parent}" ]; then
        if [ -f "${extracted_dir}/manuscript.yaml" ] || [ -d "${extracted_dir}/Book-01" ]; then
            dest_parent="${MANUSCRIPTS_BASE}"
        else
            dest_parent="${UNIVERSES_BASE}/Default-Universe"
        fi
    fi
    mkdir -p "${dest_parent}"

    local final_target="${dest_parent}/${final_name}"
    if [ -d "${final_target}" ]; then
        if [ "${force}" -eq 1 ]; then
            rm -rf "${final_target}"
        else
            echo "Error: Target directory '${final_target}' already exists. Use --force to overwrite." >&2
            return 1
        fi
    fi

    mv "${extracted_dir}" "${final_target}"
    echo "[✓] Project successfully restored to: ${final_target}"
}

cmd_export() {
    local target_input=""
    local title=""
    local author="Author Name"
    local volume="Book-01"
    local paper_size="us-trade"
    local export_fmt="book"
    while [ $# -gt 0 ]; do
        case "$1" in
            --title) title="$2"; shift 2 ;;
            --author) author="$2"; shift 2 ;;
            -b|--book|--volume) volume="$2"; shift 2 ;;
            -p|--paper-size) paper_size="$2"; shift 2 ;;
            -f|--format) export_fmt="$2"; shift 2 ;;
            --docx) export_fmt="docx"; shift ;;
            -h|--help)
                echo "Usage: arcanum export <MANUSCRIPT> [--format book|submission|all] [--book Book-01] [--paper-size us-trade]"
                return 0 ;;
            *)
                if [ -z "${target_input}" ]; then target_input="$1"; fi
                shift ;;
        esac
    done

    local target_dir
    target_dir="$(resolve_manuscript_dir "${target_input}")"
    if [ -z "${target_dir}" ] || [ ! -d "${target_dir}" ]; then
        target_dir="$(resolve_target_dir "${target_input}")"
    fi
    if [ -z "${target_dir}" ] || [ ! -d "${target_dir}" ]; then
        echo "Error: Target manuscript not found: '${target_input}'." >&2; return 1
    fi

    [ -z "${title}" ] && title="$(basename "${target_dir}")"
    local pub_dir="${target_dir}/04-Publishing"
    [ ! -d "${pub_dir}" ] && pub_dir="${target_dir}/Exports"
    mkdir -p "${pub_dir}"

    local safe_stem
    safe_stem="$(sanitize_name "${title}_${volume}" "novel")"
    local pdf_out="${pub_dir}/${safe_stem}.pdf"
    local epub_out="${pub_dir}/${safe_stem}.epub"
    local docx_out="${pub_dir}/${safe_stem}_Submission.docx"

    echo "Compiling manuscript '${title}' (${volume})..."
    local temp_work_dir
    temp_work_dir="$(mktemp -d -t arcanum_exp_XXXXXX)"
    trap 'rm -rf "${temp_work_dir:-}"' RETURN EXIT

    local combined_md="${temp_work_dir}/manuscript_combined.md"
    touch "${combined_md}"

    local search_dir="${target_dir}/${volume}"
    [ ! -d "${search_dir}" ] && search_dir="${target_dir}"

    for md_file in $(find "${search_dir}" -type f -name "*.md" ! -name ".*" | sort); do
        cat "${md_file}" >> "${combined_md}"
        printf "\n\n" >> "${combined_md}"
    done

    if [ "${export_fmt}" = "submission" ] || [ "${export_fmt}" = "docx" ] || [ "${export_fmt}" = "all" ]; then
        if command -v python3 &>/dev/null && [ -f "${PROJECT_ROOT}/scripts/lib/docx_sync.py" ]; then
            python3 - "${combined_md}" "${docx_out}" "${title}" "${author}" "${PROJECT_ROOT}/scripts/lib" << 'PYEOF' 2>/dev/null || true
import sys
from pathlib import Path
combined_md, docx_output, book_title, author_name, lib_dir = sys.argv[1:6]
sys.path.insert(0, lib_dir)
from docx_sync import parse_markdown_to_paragraphs, build_docx_package, get_docx_config
md_text = Path(combined_md).read_text(encoding='utf-8')
paragraphs = parse_markdown_to_paragraphs(md_text)
config = get_docx_config()
build_docx_package(Path(docx_output), paragraphs, config, title=book_title, author=author_name, is_full_manuscript=True)
PYEOF
            [ -s "${docx_out}" ] && echo "[✓] Standard Submission DOCX generated: ${docx_out}"
        fi
    fi

    if [ "${export_fmt}" = "book" ] || [ "${export_fmt}" = "all" ]; then
        if command -v pandoc &>/dev/null; then
            pandoc "${combined_md}" -o "${epub_out}" --metadata title="${title}" --metadata author="${author}" 2>/dev/null && echo "[✓] EPUB generated: ${epub_out}" || true
        fi
        if command -v typst &>/dev/null; then
            local typst_src="${temp_work_dir}/manuscript.typ"
            cat << 'EOF' > "${typst_src}"
#set page(paper: "us-trade", margin: (x: 1.8cm, top: 2.2cm, bottom: 2.2cm))
#set text(font: "Linux Libertine O", size: 10.5pt)
#set par(justify: true, leading: 0.72em, first-line-indent: 1.25em)
EOF
            cat "${combined_md}" >> "${typst_src}"
            typst compile "${typst_src}" "${pdf_out}" 2>/dev/null && echo "[✓] Print PDF generated: ${pdf_out}" || true
        fi
    fi

    echo "[✓] Manuscript compilation complete for '${title}'."
}

