{
  "basePath": "",
  "autoCommitMessage": "Vault backup: {{date}}",
  "autoSaveInterval": 10,
  "autoPullInterval": 0,
  "autoPushInterval": 0,
  "autoBackupAfterFileChange": true,
  "treeStructure": false,
  "refreshSourceControl": true,
  "lineAuthor": {
    "show": false,
