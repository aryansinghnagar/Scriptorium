[Desktop Entry]
Version=1.0
Type=Application
Name=Save Snapshot
GenericName=Project Snapshot
Comment=Record a point-in-time version snapshot of your manuscript and world bible
Exec=bash "__PROJECT_ROOT__/scripts/save_snapshot.sh"
TryExec=bash
Icon=document-save
Terminal=false
Categories=Office;Utility;Writing;
Keywords=Writing;Git;Snapshot;Backup;
StartupNotify=true
