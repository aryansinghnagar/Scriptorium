# PKG-04: pandoc/jq/zenity are hard runtime requirements (export_book.sh
# fails without pandoc/jq; 11 scripts branch on zenity via has_gui), so
# they belong in Depends — a --no-install-recommends install must still
# export. Typst stays in Recommends (installed as a pinned musl binary by
# setup_arcanum.sh, not via APT).
Depends: ${misc:Depends},
         bash (>= 4.3),
         python3 (>= 3.10),
         python3-gi,
         gir1.2-gtk-3.0,
         git (>= 2.34),
         tar,
         coreutils,
         pandoc (>= 2.19),
         jq,
         zenity,
         curl,
         xz-utils
Recommends: typst (>= 0.11),
            gir1.2-adw-1,
            wl-clipboard | xclip
Suggests: calibre,
          ghostscript
Provides: arcanum
Description: Local-first speculative fiction authoring and worldbuilding platform
 Ars Arcanum provides a privacy-first, offline-capable authoring, lore bible,
 and manuscript typesetting environment. It orchestrates plain Markdown prose,
 multi-tier Git repository snapshots, visual scene metadata inspection,
 multi-era timeline diagnostics, automated dramatatis personae concordances,
 and sub-second PDF/EPUB book compilation.
