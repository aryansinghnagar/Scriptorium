#!/usr/bin/make -f
# debian/rules for Ars Arcanum

%:
	dh $@

override_dh_auto_install:
	# Create target directories
	mkdir -p debian/ars-arcanum/usr/share/ars-arcanum/scripts/lib
	mkdir -p debian/ars-arcanum/usr/share/ars-arcanum/templates
	mkdir -p debian/ars-arcanum/usr/share/ars-arcanum/configs
	mkdir -p debian/ars-arcanum/usr/share/applications
	mkdir -p debian/ars-arcanum/usr/bin

	# Install scripts and library helpers (PKG-03: never ship bytecode)
	cp -r scripts/* debian/ars-arcanum/usr/share/ars-arcanum/scripts/
	find debian/ars-arcanum/usr/share/ars-arcanum -type d -name '__pycache__' -prune -exec rm -rf {} +
	find debian/ars-arcanum/usr/share/ars-arcanum -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
	chmod +x debian/ars-arcanum/usr/share/ars-arcanum/scripts/*.sh
	chmod +x debian/ars-arcanum/usr/share/ars-arcanum/scripts/arcanum
	chmod +x debian/ars-arcanum/usr/share/ars-arcanum/scripts/ars-arcanum
	chmod +x debian/ars-arcanum/usr/share/ars-arcanum/scripts/arcanum_app.py

	# Install templates and configs
	cp -r templates/* debian/ars-arcanum/usr/share/ars-arcanum/templates/
	cp -r configs/* debian/ars-arcanum/usr/share/ars-arcanum/configs/

	# Install desktop launchers (PKG-02): generate package-native entries
	# calling /usr/bin/arcanum so installed launchers never ship the
	# literal __PROJECT_ROOT__ source-tree placeholder.
	for f in launchers/*.desktop; do \
	    base=$$(basename "$$f"); \
	    case "$$base" in \
	        arcanum-control-center.desktop|ars-arcanum-control-center.desktop|scriptorium-control-center.desktop) sub="control-center";; \
	        arcanum-worldbuilding.desktop) sub="gui --tab worldbuilding";; \
	        arcanum-drafting.desktop) sub="gui --tab drafting";; \
	        arcanum-publishing.desktop) sub="gui --tab publishing";; \
	        arcanum-comparator.desktop) sub="compare";; \
	        arcanum-doctor.desktop) sub="doctor";; \
	        init-world.desktop) sub="world";; \
	        init-manuscript.desktop) sub="manuscript";; \
	        export-book.desktop) sub="export";; \
	        save-snapshot.desktop) sub="snapshot";; \
	        *) sub="";; \
	    esac; \
	    if [ -n "$$sub" ]; then \
	        sed -e 's|^Exec=.*|Exec=/usr/bin/arcanum '"$$sub"'|' -e 's|^TryExec=.*|TryExec=/usr/bin/arcanum|' "$$f" > "debian/ars-arcanum/usr/share/applications/$$base"; \
	    else \
	        sed -e 's|__PROJECT_ROOT__|/usr/share/ars-arcanum|g' "$$f" > "debian/ars-arcanum/usr/share/applications/$$base"; \
	    fi; \
	done
	# Fail the build if any placeholder survived substitution.
	! grep -r "__PROJECT_ROOT__" debian/ars-arcanum/usr/share/applications/ || (echo "ERROR: __PROJECT_ROOT__ survived launcher substitution" >&2; exit 1)

	# Create symlinks for global CLI
	ln -s /usr/share/ars-arcanum/scripts/arcanum debian/ars-arcanum/usr/bin/arcanum
	ln -s /usr/share/ars-arcanum/scripts/ars-arcanum debian/ars-arcanum/usr/bin/ars-arcanum
